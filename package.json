{
  "name": "ecom-cypress-automation",
  "version": "2.0.0",
  "private": true,
  "description": "Cypress end-to-end automation for the Ecom admin and customer portals",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:verify": "cypress verify",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:sanity": "cypress run --spec \"cypress/e2e/sanity/**/*.cy.js\"",
    "test:phase2": "cypress run --spec \"cypress/e2e/phase2/**/*.cy.js\"",
    "report:merge": "mochawesome-merge \"cypress/results/mochawesome/*.json\" > cypress/results/merged.json",
    "report:html": "marge cypress/results/merged.json --reportDir cypress/results/html --reportFilename index --inline",
    "report": "npm run report:merge && npm run report:html",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "cypress": "^13.15.1",
    "cypress-multi-reporters": "^1.6.4",
    "cypress-xpath": "^2.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.5.0",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.3.3"
  }
}
